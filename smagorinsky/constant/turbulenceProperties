FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType LES;

LES
{
    model           dynamicKEqn;
    delta           cubeRootVol;
    turbulence      on;
    printCoeffs     on;

    dynamicKEqnCoeffs
    {
        Ck      0.094;
        Ce      1.048;
    }
}



